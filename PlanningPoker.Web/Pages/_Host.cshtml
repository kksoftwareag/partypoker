@page "/"
@namespace PlanningPoker.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#054597" />
    <meta name="description" content="Planning Poker für agile Teams von der K&amp;K Software AG." />
    <title>Planning Poker | K&amp;K Software AG</title>
    <base href="~/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" asp-append-version="true" />

    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16x16.png" />
    <link rel="manifest" href="~/site.webmanifest" />
</head>
<body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <app>
        <component type="typeof(App)" render-mode="Server" />
    </app>

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Ein Fehler ist aufgetreten. Bitte lade die Seite neu.
        </environment>
        <environment include="Development">
            Eine unbehandelte Ausnahme ist aufgetreten. Details in den Entwicklertools des Browsers.
        </environment>
        <a href="" class="reload">Neu laden</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js" asp-append-version="true"></script>
    <script src="/js/kk.js" asp-append-version="true"></script>
    <script src="/js/audio.js" asp-append-version="true"></script>
</body>
</html>
