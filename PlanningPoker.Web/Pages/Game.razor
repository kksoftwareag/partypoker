@page "/{Hash}"
@inherits GameViewModel

<div id="game" @onkeydown="this.OnKeyDown">
    <div class="row">
        <div class="col-auto">
            <label for="player-name">Your name:</label>
        </div>

        <div class="col">
            @if (this.Player != null)
            {
                <input id="player-name" class="form-control" type="text" value="@this.PlayerName" @onchange="this.NameChanged" @onkeydown:stopPropagation="true" />
            }
        </div>
    </div>

    @if (this.Game != null)
    {
        <div class="row mt-3">
            <div class="col-auto">
                <button class="btn btn-primary"
                        disabled="@(this.Game.CurrentRound == null || (this.Game.CurrentRound.Cards.Any() == false && !this.Game.CurrentRound.IsRevealing) || this.Game.CurrentRound.IsRevealed == true)"
                        @onclick="!this.Game.CurrentRound.IsRevealing ? this.RevealCards : this.RevealCardsNow">
                    @if (!this.Game.CurrentRound.IsRevealing)
                    {
                        @:🃏 Reveal Cards
                    }
                    else
                    {
                        @:🃏 Reveal Cards now
                    }
                </button>
            </div>
            <div class="col-auto">
                <div class="row align-items-center">
                    <div class="col-auto">Reveal countdown:</div>
                    <select disabled="@(this.Game.CurrentRound.IsRevealing && !this.Game.CurrentRound.IsRevealed)" class="form-control col" @bind="@this.Game.SelectedCountDown">
                        @foreach (var countdown in this.Game.RevealCountDownInSeconds)
                        {
                            <option value="@countdown">@($"{countdown}s")</option>
                        }
                    </select>

                    <button class="btn col-auto ml-1 mr-1 @(this.Game.SelectedCountDown == 0 ? "btn-outline-success" : "btn-success")"
                            disabled="@(this.Game.SelectedCountDown == 0 || this.Game.CurrentRound == null || this.Game.CurrentRound.IsRevealed == true || this.Game.CurrentRound.IsRevealing == true)"
                            @onclick="this.RevealCardsWithCountdown">
                        @if (this.Game.CurrentRound.IsRevealing && !this.Game.CurrentRound.IsRevealed)
                        {
                            @:🕑 @(this.Game.TimerSeconds)s
                        }
                        else
                        {
                            @:🕑
                        }
                    </button>
                    @if (this.Game.CurrentRound.IsRevealing)
                    {
                        <button class="btn col btn-outline-danger"
                                disabled="@(this.Game.SelectedCountDown == 0 || this.Game.CurrentRound == null)"
                                @onclick="this.CancelCardsWithCountdown">
                            ❌
                        </button>
                    }
                </div>

            </div>
            @if (this.Player is not null)
            {
                <div class="col-auto">
                    <button class="btn btn-primary"
                            disabled="@(this.Game.CurrentRound?.IsRevealed == true || this.Game.CurrentRound.IsRevealing == true)"
                            @onclick="this.SwitchPlayStatus">
                        @(this.Player!.IsPlaying ? "👁 Spectate" : "🃏 Play")
                    </button>
                </div>
            }
            <div class="col-auto">
                <button class="btn btn-success" 
                        disabled="@(this.Game.CurrentRound?.IsRevealed == false)" 
                        @onclick="this.StartNewRound">
                        ✅ Start Round @(1 + this.Game.RoundNumber)
                    </button>
            </div>
            <div class="col-auto">
                <a class="btn btn-info" 
                   target="_blank" 
                   href="https://t.me/share/url?url=https://planningpoker.party/@this.Hash&text=Planning%20Poker">
                   🔗 Share via Telegram
               </a>
            </div>
        </div>
    }

    @if (this.Game?.CurrentRound != null)
    {
        @if (this.Game.Players.Count > 0)
        {
            <div class="row mt-3">
                <div class="col">
                    <div class="hstack">
                        <h4>Players</h4>
                        <button class="btn btn-info players-notify" 
                                @onclick="this.PlayBingSound">
                            🔊
                        </button>
                    </div>
                    @foreach (var player in this.Game.Players)
                    {
                        <div style="margin-top:10px" class="player-container">
                            <div class="player-notify">
                                <a href="javascript:void(0);" @onclick="(() => this.PlayBingSoundForPlayer(player))">🔊</a>
                            </div>

                            <div class="player">
                                @player.Name
                            </div>

                            <div class="player-card">
                                @if (this.Game.CurrentRound.Cards.ContainsKey(player) == true)
                                {
                                    if (this.Game.CurrentRound.IsRevealed == true)
                                    {
                                        <div class="player-card-revealed">
                                            @this.Game.CurrentRound.Cards[player]
                                        </div>
                                    }
                                    else
                                    {
                                        @:🃏
                                    }
                                }
                                else
                                {
                                    @:❌
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="row mt-3">
            <div class="col">
                @if (this.Game != null && this.Game.CurrentRound != null && this.Player != null && this.Game.Players.Any() && !this.Game.CurrentRound.IsRevealed)
                {
                    if (this.Player.IsPlaying)
                    {
                        @foreach (var card in this.Game.CardDeck)
                        {
                            <button class="btn btn-outline-secondary mr-2" @onclick="(() => this.VoteCard(card))">
                                @if (card == this.CardChoosenInCurrentRound)
                                {
                                    <strong style="color: white;">
                                        @card
                                    </strong>
                                }
                                else
                                {
                                    @card
                                }
                            </button>
                        }
                    }
                }
            </div>
        </div>

        @if (this.Game.Spectators.Count > 0)
        {
            <div class="row mt-3">
                <div class="col">
                    <h4>Spectators</h4>
                    <br />
                    @foreach (var spectator in this.Game.Spectators)
                    {
                        <div class="player-container">
                            <div class="player-notify">
                                <a href="javascript:void(0);" @onclick="(() => this.PlayBingSoundForPlayer(spectator))">🔊</a>
                            </div>

                            <div class="player">
                                @spectator.Name
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="row mt-3">
            <div class="col">
                @if (this.Game != null && this.Game.CurrentRound != null && this.Player != null && this.Game.Players.Any() && this.Game.CurrentRound.IsRevealed)
                {
                    <div class="mt-3"><h4>Result:</h4></div>
                    <div class="mt-3"><h5 style="margin-top:10px">Card counts</h5></div>
                    <div class="mt-3">
                        <table>
                            @foreach (var selectedCard in this.Game.CurrentRound.Cards
                                                .GroupBy(c => c.Value)
                                                .OrderByDescending(k => k.Count())
                                                .ThenBy(k => double.TryParse(k.Key, out var parsedValue) ? parsedValue : 0))
                            {
                                <tr>
                                    <td>@($"🃏 {selectedCard.Key}")</td>
                                    <td>=</td>
                                    <td>@($"{selectedCard.Count()}")</td>
                                </tr>
                            }
                        </table>
                    </div>
                    <div class="mt-3">@($"Total votes: {this.Game.CurrentRound.Cards.Count()}")</div>
                    <div>@($"Highest vote(s): {string.Join(", ", this.Game.CurrentRound.HighestCardsWithPlayer.Select(c => c.Player.Name))}")</div>
                    <div>@($"Lowest vote(s): {string.Join(", ", this.Game.CurrentRound.LowestCardsWithPlayer.Select(c => c.Player.Name))}")</div>
                }
            </div>
        </div>
    }
</div>
