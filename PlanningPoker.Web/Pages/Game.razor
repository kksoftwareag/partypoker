@page "/{Hash}"
@inherits GameViewModel

@if (this.Game is null)
{
    return;
}

<div id="game" @onkeydown="this.OnKeyDown" class="container">

    @* ---------- Status + moderation actions ---------- *@
    <section class="game-topbar" aria-label="Rundenstatus">
        <div class="round-info">
            <div class="round-title">Runde @this.RoundNumber</div>
            <div class="round-sub">@this.StatusText</div>
        </div>

        <div class="vote-progress" role="group" aria-label="Abstimmungsfortschritt">
            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="@this.ActiveVoterCount" aria-valuenow="@this.VoteCount">
                <span style="width: @(this.VotePercent)%"></span>
            </div>
            <span class="count">@this.VoteCount / @this.ActiveVoterCount haben gewählt</span>
        </div>

        <div class="topbar-actions">
            <button type="button" class="btn @(this.IsAllVoted ? "btn-accent" : "btn-primary")"
                    disabled="@(this.CanReveal == false)"
                    @onclick="this.RevealCardsOrNow">
                <span aria-hidden="true">🃏</span> @this.RevealLabel
            </button>

            @if (this.IsRevealed)
            {
                <button type="button" class="btn btn-accent" @onclick="this.StartNewRound">
                    <span aria-hidden="true">→</span> Runde @(this.RoundNumber + 1) starten
                </button>
            }
        </div>
    </section>

    <div class="game-layout">
        <div>
            @* ---------- Players ---------- *@
            <section aria-labelledby="players-title">
                <div class="section-head">
                    <h3 id="players-title">Spieler <span class="meta">(@this.ActiveVoterCount)</span></h3>
                    @if (this.Game.Players.Count > 0)
                    {
                        <button type="button" class="btn btn-sm btn-outline" @onclick="this.PlayBingSound">
                            <span aria-hidden="true">🔊</span> Alle erinnern
                        </button>
                    }
                </div>

                @if (this.Game.Players.Count == 0)
                {
                    <p class="meta">Noch niemand am Tisch. Bitte teile den Link rechts.</p>
                }
                else
                {
                    <div class="player-grid">
                        @foreach (var player in this.Game.Players)
                        {
                            var hasCard = this.CurrentRound.Cards.ContainsKey(player);
                            var isMe = player == this.Player;
                            var highest = this.IsRevealed && this.CurrentRound.HighestCardsWithPlayer.Any(h => h.Player == player);
                            var lowest = this.IsRevealed && this.CurrentRound.LowestCardsWithPlayer.Any(l => l.Player == player) && this.HighestNames != this.LowestNames;

                            <div class="player-card @(isMe ? "is-me" : "")" @key="player.Secret">
                                <button type="button" class="ping-btn" disabled="@(isMe || this.IsRevealed)"
                                        title="An @player.Name erinnern" aria-label="An @player.Name erinnern"
                                        @onclick="() => this.PlayBingSoundForPlayer(player)">
                                    <span aria-hidden="true">🔔</span>
                                </button>

                                @if (highest)
                                {
                                    <span class="tag">↑ hoch</span>
                                }
                                else if (lowest)
                                {
                                    <span class="tag" style="background: var(--kk-blue-100); color: var(--kk-blue);">↓ niedrig</span>
                                }

                                <div class="player-name" title="@player.Name">@player.Name</div>

                                <div class="card-face @CardStateClass(hasCard, highest, lowest, isMe)"
                                     aria-label="@CardLabel(player.Name, hasCard)">
                                    @if (this.IsRevealed && hasCard)
                                    {
                                        @this.CurrentRound.Cards[player]
                                    }
                                    else if (hasCard)
                                    {
                                        <span aria-hidden="true">♠</span>
                                    }
                                    else
                                    {
                                        <span aria-hidden="true">&#183;</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            @* ---------- Your hand ---------- *@
            <section class="hand" style="margin-top: var(--space-5);" aria-labelledby="hand-title">
                <div class="hand-head">
                    <h3 id="hand-title">Deine Karte</h3>
                    @if (this.IsPlaying && this.IsRevealed == false && this.IsRevealing == false)
                    {
                        <span class="hint">Tipp: Die Tastatur wählt die Karte mit demselben Zeichen</span>
                    }
                </div>

                @if (this.IsPlaying == false)
                {
                    <div class="spectate-banner">
                        <span>👁 Du schaust zu und stimmst nicht ab.</span>
                        <button type="button" class="btn btn-sm btn-primary" disabled="@(this.IsRevealed || this.IsRevealing)" @onclick="this.SwitchPlayStatus">
                            Mitschätzen
                        </button>
                    </div>
                }
                else if (this.IsRevealed)
                {
                    <div class="spectate-banner" style="background: var(--kk-green-anteil); color: #17300a;">
                        <span>Karten aufgedeckt. Dein Beitrag: <strong>@(this.CardChoosenInCurrentRound ?? "&#183;")</strong></span>
                        <button type="button" class="btn btn-sm btn-accent" @onclick="this.StartNewRound">Nächste Runde</button>
                    </div>
                }
                else
                {
                    <div class="hand-cards" role="group" aria-label="Kartenauswahl" style="--hand-cards: @this.Game.CardDeck.Length">
                        @foreach (var card in this.Game.CardDeck)
                        {
                            var selected = card == this.CardChoosenInCurrentRound;
                            <button type="button" class="hand-card"
                                    aria-pressed="@(selected ? "true" : "false")"
                                    aria-label="Karte @card"
                                    disabled="@this.IsRevealing"
                                    @onclick="() => this.VoteCard(card)">
                                @card
                                <kbd>@card</kbd>
                            </button>
                        }
                    </div>
                }

                <div class="hand-foot">
                    <div class="field" style="min-width: 220px;">
                        <label for="player-name">Dein Name</label>
                        <div style="display: flex; gap: var(--space-2);">
                            <input id="player-name" class="input" type="text" value="@this.PlayerName" maxlength="40"
                                   placeholder="Name für die anderen" @onchange="this.NameChanged" @onkeydown:stopPropagation="true" />
                            @if (this.IsPlaying)
                            {
                                <button type="button" class="btn btn-sm btn-outline" title="Stattdessen nur zuschauen"
                                        disabled="@(this.IsRevealed || this.IsRevealing)" @onclick="this.SwitchToSpectator">
                                    👁 Zuschauen
                                </button>
                            }
                        </div>
                    </div>

                    <div class="field" style="margin-left: auto;">
                        <label id="countdown-label">Countdown vor dem Aufdecken</label>
                        <div style="display: flex; gap: var(--space-2); align-items: center;">
                            <div class="segmented" role="group" aria-labelledby="countdown-label">
                                @foreach (var seconds in this.Game.RevealCountDownInSeconds)
                                {
                                    <button type="button" aria-pressed="@(this.Game.SelectedCountDown == seconds ? "true" : "false")"
                                            disabled="@this.IsRevealing"
                                            @onclick="() => this.SelectCountdown(seconds)">
                                        @(seconds == 0 ? "aus" : $"{seconds}s")
                                    </button>
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-primary"
                                    disabled="@(this.Game.SelectedCountDown == 0 || this.IsRevealing || this.IsRevealed || this.VoteCount == 0)"
                                    title="Mit Countdown aufdecken"
                                    @onclick="this.RevealCardsWithCountdown">
                                ⏱ Start
                            </button>
                            @if (this.IsRevealing)
                            {
                                <span class="count" style="color: var(--kk-blue); font-weight: 700;">@this.CountdownDisplay s</span>
                                <button type="button" class="btn btn-sm btn-danger-outline" @onclick="this.CancelCardsWithCountdown">
                                    Abbrechen
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </section>

            @* ---------- Results ---------- *@
            @if (this.IsRevealed)
            {
                <section class="results" aria-labelledby="result-title">
                    <div class="results-head">
                        <h3 id="result-title">Ergebnis</h3>
                        <span class="meta">@this.VoteCount Stimme(n) in Runde @this.RoundNumber</span>
                    </div>

                    <div class="dist" role="img" aria-label="@this.ResultSummary">
                        @foreach (var item in this.CardCounts)
                        {
                            var isTop = item.Count == this.MaxCardCount;
                            <div class="dist-col @(isTop ? "is-top" : "")" title="@string.Join(", ", item.Players)">
                                <div class="bar" style="height: @(BarHeight(item.Count))%;">
                                    <span class="n">@item.Count×</span>
                                </div>
                                <span class="label">@item.Card</span>
                            </div>
                        }
                    </div>

                    <div class="stat-grid">
                        <div class="stat @(this.IsConsensus ? "is-consensus" : "")">
                            <div class="k">Konsens</div>
                            <div class="v">@(this.IsConsensus ? $"✓ {this.CardCounts[0].Card}" : "≠")</div>
                            <div class="d">@(this.IsConsensus ? "Alle einig" : $"{this.CardCounts.Count} verschiedene Karten")</div>
                        </div>
                        <div class="stat">
                            <div class="k">Durchschnitt</div>
                            <div class="v">@(this.AverageCard?.ToString("0.#") ?? "&#183;")</div>
                            <div class="d">ohne Fragezeichen / Kaffee</div>
                        </div>
                        <div class="stat">
                            <div class="k">Höchste</div>
                            <div class="v">@this.HighestValue</div>
                            <div class="d" title="@this.HighestNames">@this.HighestNames</div>
                        </div>
                        <div class="stat">
                            <div class="k">Niedrigste</div>
                            <div class="v">@this.LowestValue</div>
                            <div class="d" title="@this.LowestNames">@this.LowestNames</div>
                        </div>
                    </div>

                    @if (this.HasSpread)
                    {
                        <div class="spread-note">
                            <span aria-hidden="true">⚖️</span>
                            <span>Die Schätzungen liegen weit auseinander. Diese Geschichte kurz besprechen oder ein zweites Mal schätzen.</span>
                        </div>
                    }
                </section>
            }
        </div>

        @* ---------- Sidebar ---------- *@
        <aside class="side" aria-label="Raum und Verlauf">
            <div class="card">
                <div class="panel-title"><h3>Einladen</h3></div>
                <div class="side-details">
                    <div class="room-line">
                        <code>@this.Hash</code>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="this.CopyInviteLink">Link kopieren</button>
                    </div>
                    <a class="btn btn-sm btn-outline" target="_blank" rel="noopener"
                       href="https://t.me/share/url?url=@(Uri.EscapeDataString(this.ShareUrl))&text=Planning%20Poker%20Runde">
                        <span aria-hidden="true">📣</span> Per Telegram teilen
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="panel-title">
                    <h3>Verlauf</h3>
                    <span class="meta">@this.Game.Rounds.Count Runde(n)</span>
                </div>
                <div class="history">
                    @foreach (var round in this.History)
                    {
                        <div class="history-row" @key="round.Round">
                            <span class="who">Runde @round.Round · @round.Votes Stimme(n)</span>
                            @if (round.IsRevealed)
                            {
                                <span class="value">@(round.CommonCard ?? "&#183;")</span>
                                @if (round.Average.HasValue)
                                {
                                    <span class="who" style="flex: none;">Ø @round.Average.Value.ToString("0.#")</span>
                                }
                            }
                            else
                            {
                                <span class="value is-open">läuft</span>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (this.Game.Spectators.Count > 0)
            {
                <div class="card">
                    <div class="panel-title"><h3>Zuschauer</h3></div>
                    <div class="spectator-list">
                        @foreach (var spectator in this.Game.Spectators)
                        {
                            <span class="chip">
                                @spectator.Name
                                <button type="button" title="An @spectator.Name erinnern" aria-label="An @spectator.Name erinnern"
                                        @onclick="() => this.PlayBingSoundForPlayer(spectator)">🔔</button>
                            </span>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>

    <ToastHost />
</div>

@code {
    private string StatusText
    {
        get
        {
            if (this.IsRevealed)
            {
                return "Karten aufgedeckt. Bitte besprecht das Ergebnis und startet die nächste Runde.";
            }

            if (this.IsRevealing)
            {
                return $"Aufdecken in {this.Game.TimerSeconds} s. Jetzt können alle noch abstimmen.";
            }

            if (this.IsAllVoted)
            {
                return "Alle haben gewählt. Zeit zum Aufdecken.";
            }

            if (this.ActiveVoterCount == 0)
            {
                return "Noch keine aktiven Spieler.";
            }

            return this.HasVotedInRound ? "Du hast gewählt. Warte auf die anderen." : "Wähle deine Karte.";
        }
    }

    // Bar height as the share of all votes (a 1:1 tie shows as two half-height bars);
    // small shares are lifted to a visible minimum.
    private int BarHeight(int count)
    {
        var total = this.CardCounts.Sum(c => c.Count);

        return total == 0 ? 0 : Math.Max(12, 100 * count / total);
    }

    private string ResultSummary => string.Join(", ", this.CardCounts.Select(c => $"{c.Card} von {c.Count}"));

    private string CardStateClass(bool hasCard, bool highest, bool lowest, bool isMe)
    {
        if (this.IsRevealed)
        {
            return string.Join(" ", new[]
            {
                hasCard ? "is-revealed" : "is-empty",
                highest ? "is-highest" : null,
                lowest ? "is-lowest" : null,
                isMe && !highest ? "is-mine" : null,
            }.Where(s => s is not null));
        }

        return hasCard ? "is-back" : "is-empty";
    }

    private static string CardLabel(string name, bool hasCard) =>
        hasCard ? $"{name} hat gewählt" : $"{name} hat noch nicht gewählt";
}
