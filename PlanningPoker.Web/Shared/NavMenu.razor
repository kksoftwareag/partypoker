@inject UserState UserState

<header class="site-header">
    <div class="container">
        <span class="brand">
            <img class="brand-logo" src="img/kk-logo.webp" width="82" height="56" alt="K&amp;K Software AG" />
            <span class="brand-wordmark">
                <strong>Planning Poker</strong>
                <span>K&amp;K Software AG</span>
            </span>
        </span>

        @if (this.UserState.CurrentGame is not null)
        {
            <div class="header-room">
                <div>
                    <span class="room-label">Raum</span>
                    <span class="room-code">@this.UserState.CurrentGame</span>
                </div>
            </div>
        }
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        this.UserState.GamesChangedEvent += (s, e) => _ = this.InvokeAsync(() => this.StateHasChanged());
    }
}
